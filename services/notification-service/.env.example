SECRET_KEY=dev-only-change-before-deploy
DEBUG=True
# Wildcarded for local dev only (lets a phone on your LAN reach this via its IP) — lock this down to real hostnames before staging/prod.
ALLOWED_HOSTS=*

DATABASE_URL=postgres://loaded:loaded@localhost:5432/notif_db

CORS_ALLOWED_ORIGINS=

JWT_PUBLIC_KEY_PATH=../../infra/dev-keys/jwt-public.pem

REDIS_URL=redis://localhost:6379/0

# Firebase service account credentials, used by `manage.py send_due_reminders`
# to send pushes. Get this from Firebase Console -> Project settings ->
# Service accounts -> Generate new private key. Use ONE of the two below —
# the path is easier for local dev (point it at the downloaded file), the
# inline JSON is for platforms where only env vars are practical. Never
# commit either — this credential can send push notifications as your app.
FCM_SERVICE_ACCOUNT_JSON_PATH=
FCM_SERVICE_ACCOUNT_JSON=

# How often (seconds) the scheduler checks for due reminders.
REMINDER_CHECK_INTERVAL_SECONDS=30

LOG_LEVEL=INFO
