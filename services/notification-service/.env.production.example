# Production template — every value below MUST be set explicitly; nothing here
# has a safe default. See config/settings.py's `if not DEBUG:` block — it will
# refuse to start if ALLOWED_HOSTS is "*" or SECRET_KEY looks like a dev key.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=False

# Comma-separated, no wildcard. e.g. notifications.loadedapp.example
ALLOWED_HOSTS=

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/notif_db

CORS_ALLOWED_ORIGINS=

JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=loaded-auth-service

REDIS_URL=

# Firebase service account JSON (single-line) — needed once push sending is
# actually implemented (implementation plan Phase 4, not built yet).
FCM_SERVICE_ACCOUNT_JSON=

LOG_LEVEL=INFO
