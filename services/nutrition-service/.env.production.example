# Production template — every value below MUST be set explicitly.

DEBUG=False

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/nutrition_db

CORS_ALLOWED_ORIGINS=

# This service only ever verifies tokens — the production PUBLIC key only
# (never the private one). Must be the public half of Auth Service's real
# production keypair, not infra/dev-keys.
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=loaded-auth-service

LOG_LEVEL=INFO
