# Production template — every value below MUST be set explicitly; nothing here
# has a safe default. See config/settings.py's `if not DEBUG:` block — it will
# refuse to start if ALLOWED_HOSTS is "*" or SECRET_KEY looks like a dev key.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=False

# Comma-separated, no wildcard. e.g. auth.loadedapp.example
ALLOWED_HOSTS=

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/auth_db

# The app's real origin(s) only — never "*" in production.
CORS_ALLOWED_ORIGINS=

# RS256 keypair — generate a REAL production pair, never reuse infra/dev-keys
# (that one is committed to the repo for local dev only and must be treated
# as compromised). Store the private key in your platform's secret manager,
# not as a plain env var if avoidable — this is the one secret that lets
# someone forge a valid session for any user if it leaks.
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
# Must match JWT_ISSUER on every other service, and Kong's consumer key
# (gateway/kong.yml) if the gateway is in front of these services.
JWT_ISSUER=loaded-auth-service

REDIS_URL=

GOOGLE_OAUTH_CLIENT_ID=

# A real transactional email provider — the console backend only prints to
# stdout, which does nothing for a real user's password reset.
EMAIL_BACKEND=django.core.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@loadedapp.example
FRONTEND_PASSWORD_RESET_URL=

LOG_LEVEL=INFO
