# Copy to .env for local (non-Docker) runs. In Docker Compose these are set in infra/docker-compose.yml instead.

SECRET_KEY=dev-only-change-before-deploy
DEBUG=True
# Wildcarded for local dev only (lets a phone on your LAN reach this via its IP) — lock this down to real hostnames before staging/prod.
ALLOWED_HOSTS=*

DATABASE_URL=postgres://loaded:loaded@localhost:5432/auth_db

CORS_ALLOWED_ORIGINS=

# RS256 keypair — Auth Service is the only service with the private key.
# For local dev these point at infra/dev-keys (generated once, not for production use).
JWT_PRIVATE_KEY_PATH=../../infra/dev-keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../../infra/dev-keys/jwt-public.pem

REDIS_URL=redis://localhost:6379/0

GOOGLE_OAUTH_CLIENT_ID=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@loadedapp.example
FRONTEND_PASSWORD_RESET_URL=loadedapp://reset-password

LOG_LEVEL=INFO
