# Copy to .env.production on the server (never commit the real file — see
# .gitignore). Fill in real values before running:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d

# The domain pointing at this server, e.g. loaded.duckdns.org or a free
# sslip.io/nip.io name derived from the server's IP. Used for
# ALLOWED_HOSTS/CORS and as Caddy's automatic-HTTPS certificate name.
DOMAIN=

# Generate each with: openssl rand -base64 48
# A DIFFERENT random value per service — never reuse one across services,
# and never reuse the dev-only "dev-only-change-before-deploy" placeholder.
AUTH_SECRET_KEY=
WORKOUT_SECRET_KEY=
ANALYTICS_SECRET_KEY=
NOTIFICATION_SECRET_KEY=

# Generate with: openssl rand -hex 24
# Must be -hex, not -base64 — base64 output can contain '/', '+', '='
# which break the postgres://user:PASSWORD@host/db URL it gets embedded in.
POSTGRES_PASSWORD=

# The WEB application OAuth client ID from Google Cloud Console (see
# docs/07-RUNBOOK.md section 2) — must match what the mobile app's
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID is built with.
GOOGLE_OAUTH_CLIENT_ID=
