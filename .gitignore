# Python
venv/
__pycache__/
*.pyc
db.sqlite3
staticfiles/

# Node / Expo
node_modules/
.expo/
dist/
web-build/

# Env files
.env
.env.local

# Secrets — never commit a private key, even a throwaway dev one.
# Regenerate locally with infra/dev-keys/generate.sh (see infra/dev-keys/README.md).
infra/dev-keys/*.pem
infra/prod-keys/*.pem
infra/.env.production

# Firebase service account credentials — lets someone send push notifications
# as this app if it leaks. Point FCM_SERVICE_ACCOUNT_JSON_PATH at wherever you
# actually keep the downloaded file; this just stops the common mistake of
# dropping it directly into the repo.
*firebase-adminsdk*.json
firebase-service-account*.json
serviceAccountKey.json

# google-services.json (Android FCM client config) is deliberately NOT
# ignored: it contains no secret (Firebase's own docs treat its API key as
# public — access is controlled by Firebase Security Rules/App Check, not by
# hiding this file), and EAS Build needs it git-tracked to bundle it.

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
command-log.md
