# Copy to .env — Expo CLI loads EXPO_PUBLIC_* vars from it automatically,
# no dotenv package needed. Everything here is safe to ship inside the app
# bundle (hence the EXPO_PUBLIC_ prefix requirement) — nothing secret goes
# here; real secrets (JWT private key, FCM service account) live only on
# the backend services, never in the app.

# Direct-to-service URLs. Defaults (10.0.2.2 for Android emulator, localhost
# otherwise) are usually fine — only set these to test against a physical
# device on your LAN, using your machine's IP instead of localhost.
# EXPO_PUBLIC_AUTH_API_URL=http://192.168.1.x:8001/api
# EXPO_PUBLIC_WORKOUT_API_URL=http://192.168.1.x:8002/api
# EXPO_PUBLIC_ANALYTICS_API_URL=http://192.168.1.x:8003/api
# EXPO_PUBLIC_NOTIFICATION_API_URL=http://192.168.1.x:8004/api

# Google Sign-In — the WEB application OAuth client id from Google Cloud
# Console (not the Android one — see docs, Google Sign-In setup). Must match
# Auth Service's GOOGLE_OAUTH_CLIENT_ID exactly, since that's what the
# backend verifies the token's audience against.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
